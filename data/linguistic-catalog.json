  "grammarRules": [
    {
      "id": "CAP-I-001",
      "implementation": "capital-i",
      "level": "A1",
      "category": "capitalization",
      "title": "Capitalize the pronoun I",
      "titleEs": "Escribe I con mayúscula",
      "explanation": "The subject pronoun I is always capitalized.",
      "explanationEs": "El pronombre I siempre se escribe con mayúscula.",
      "examples": [
        "I am a teacher.",
        "I enjoy teaching."
      ],
      "incorrect": [
        "i am a teacher."
      ],
      "severity": "medium",
      "priority": "high",
      "status": "tested"
    },
    {
      "id": "SPELL-TEACHER-001",
      "implementation": "spelling-teacher",
      "level": "A1",
      "category": "spelling",
      "title": "Spell teacher correctly",
      "titleEs": "Escribe teacher correctamente",
      "explanation": "The word is spelled teacher.",
      "explanationEs": "La palabra se escribe teacher.",
      "examples": [
        "I am a teacher."
      ],
      "incorrect": [
        "I am a techer."
      ],
      "severity": "medium",
      "priority": "medium",
      "status": "tested"
    },
    {
      "id": "ART-JOB-001",
      "implementation": "article-profession",
      "level": "A1-A2",
      "category": "articles",
      "title": "Use an article before a singular job",
      "titleEs": "Usa un artículo antes de una profesión singular",
      "explanation": "Use a/an before a singular countable job noun.",
      "explanationEs": "Usa a/an antes de un sustantivo contable singular que indique una profesión.",
      "examples": [
        "I am a teacher.",
        "She is an engineer."
      ],
      "incorrect": [
        "I am teacher."
      ],
      "severity": "high",
      "priority": "high",
      "status": "tested"
    },
    {
      "id": "ART-A-AN-001",
      "implementation": "article-a-an",
      "level": "A1-A2",
      "category": "articles",
      "title": "Choose a or an by sound",
      "titleEs": "Elige a o an según el sonido",
      "explanation": "Use an before a vowel sound, and a before a consonant sound.",
      "explanationEs": "Usa an antes de un sonido vocálico y a antes de un sonido consonántico.",
      "examples": [
        "an engineer",
        "a university"
      ],
      "incorrect": [
        "a engineer"
      ],
      "severity": "medium",
      "priority": "high",
      "status": "tested"
    },
    {
      "id": "BE-SUBJECT-001",
      "implementation": "be-agreement",
      "level": "A1",
      "category": "verb-forms",
      "title": "Match be to the subject",
      "titleEs": "Conjuga be según el sujeto",
      "explanation": "Use am with I, is with he/she/it, and are with you/we/they.",
      "explanationEs": "Usa am con I, is con he/she/it y are con you/we/they.",
      "examples": [
        "I am ready.",
        "They are students."
      ],
      "incorrect": [
        "I are ready.",
        "She are a teacher."
      ],
      "severity": "high",
      "priority": "high",
      "status": "tested"
    },
    {
      "id": "SVA-PLURAL-001",
      "implementation": "plural-agreement",
      "level": "A2",
      "category": "subject-verb-agreement",
      "title": "Use the base verb with plural subjects",
      "titleEs": "Usa el verbo base con sujetos plurales",
      "explanation": "In the present simple, plural subjects use the base verb form.",
      "explanationEs": "En presente simple, los sujetos plurales usan la forma base del verbo.",
      "examples": [
        "My students build robots.",
        "The teachers work here."
      ],
      "incorrect": [
        "The students builds robots."
      ],
      "severity": "high",
      "priority": "high",
      "status": "tested"
    },
    {
      "id": "SVA-3SG-001",
      "implementation": "third-person-singular",
      "level": "A2",
      "category": "subject-verb-agreement",
      "title": "Add -s/-es with he, she or it",
      "titleEs": "Añade -s/-es con he, she o it",
      "explanation": "In affirmative present simple, he/she/it usually takes a verb ending in -s or -es.",
      "explanationEs": "En presente simple afirmativo, he/she/it normalmente requiere un verbo terminado en -s o -es.",
      "examples": [
        "She teaches robotics.",
        "The robot uses a sensor."
      ],
      "incorrect": [
        "She teach robotics."
      ],
      "severity": "high",
      "priority": "high",
      "status": "tested"
    },
    {
      "id": "VERB-ENJOY-001",
      "implementation": "enjoy-gerund",
      "level": "A2",
      "category": "verb-patterns",
      "title": "Use -ing after enjoy",
      "titleEs": "Usa -ing después de enjoy",
      "explanation": "Enjoy is followed by a noun or a verb ending in -ing.",
      "explanationEs": "Después de enjoy se usa un sustantivo o un verbo terminado en -ing.",
      "examples": [
        "I enjoy teaching.",
        "I enjoy building robots."
      ],
      "incorrect": [
        "I enjoy to teach."
      ],
      "severity": "high",
      "priority": "high",
      "status": "tested"
    },
    {
      "id": "VERB-LIKE-001",
      "implementation": "like-gerund",
      "level": "A2",
      "category": "verb-patterns",
      "title": "Use common patterns after like",
      "titleEs": "Usa patrones frecuentes después de like",
      "explanation": "Like can be followed by a noun, a verb ending in -ing, or to + base verb.",
      "explanationEs": "Like puede ir seguido de un sustantivo, un verbo con -ing o to + verbo base.",
      "examples": [
        "I like teaching.",
        "I like to teach."
      ],
      "incorrect": [],
      "severity": "low",
      "priority": "low",
      "status": "tested"
    },
    {
      "id": "WORD-ORDER-001",
      "implementation": "adjective-noun-order",
      "level": "A2",
      "category": "syntax",
      "title": "Put adjectives before nouns",
      "titleEs": "Coloca los adjetivos antes del sustantivo",
      "explanation": "In a typical English noun phrase, an adjective comes before the noun.",
      "explanationEs": "En una frase nominal típica en inglés, el adjetivo va antes del sustantivo.",
      "examples": [
        "a difficult problem",
        "a new robot"
      ],
      "incorrect": [
        "a problem difficult"
      ],
      "severity": "medium",
      "priority": "medium",
      "status": "tested"
    },
    {
      "id": "CONN-REPEAT-001",
      "implementation": "repeated-connector",
      "level": "A1-A2",
      "category": "connectors",
      "title": "Avoid accidental repeated connectors",
      "titleEs": "Evita repetir conectores por accidente",
      "explanation": "Do not repeat the same connector twice in a row unless quoting or deliberately repeating it.",
      "explanationEs": "No repitas el mismo conector dos veces seguidas, salvo que estés citando o repitiendo deliberadamente.",
      "examples": [
        "I teach robotics and I enjoy it."
      ],
      "incorrect": [
        "I teach and and enjoy it."
      ],
      "severity": "low",
      "priority": "low",
      "status": "tested"
    },
    {
      "id": "SPELL-OPEN-001",
      "implementation": "open-vocabulary-policy",
      "level": "A1-B1",
      "category": "open-vocabulary",
      "title": "Handle words not in the vocabulary list",
      "titleEs": "Gestiona palabras que no están en la lista",
      "explanation": "An unknown word is not automatically an error. Use context and grammar; suggest spelling only when the match is strong and unambiguous.",
      "explanationEs": "Una palabra desconocida no es automáticamente un error. Usa el contexto y la gramática; sugiere ortografía solo cuando la coincidencia sea clara y no ambigua.",
      "examples": [
        "I work with Arduino.",
        "I teach robotics."
      ],
      "incorrect": [],
      "severity": "low",
      "priority": "low",
      "status": "policy"
    }
  ],
