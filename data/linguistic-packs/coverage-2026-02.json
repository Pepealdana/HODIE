  "grammarRules": [
    {
      "id": "PLURAL-COUNT-001",
      "implementation": "plural-after-number",
      "level": "A1",
      "category": "plurals",
      "title": "Use plural nouns after numbers greater than one",
      "titleEs": "Usa sustantivos en plural después de números mayores que uno",
      "explanation": "Use a plural count noun after two, three, four, five, many or several. This matcher covers a reviewed set of regular nouns.",
      "explanationEs": "Usa un sustantivo contable en plural después de two, three, four, five, many o several. Este patrón cubre un conjunto revisado de sustantivos regulares.",
      "examples": [
        "I have two robots.",
        "We use several sensors."
      ],
      "examplesBilingual": [
        {
          "en": "I have two robots.",
          "es": "Tengo dos robots."
        },
        {
          "en": "We use several sensors.",
          "es": "Usamos varios sensores."
        }
      ],
      "incorrect": [
        "I have two robot."
      ],
      "exceptions": [
        "Irregular plurals such as children and people are not handled.",
        "Uncountable nouns such as equipment and information do not take this pattern."
      ],
      "negativeCases": [
        {
          "text": "I have one robot.",
          "reason": "Singular after one is correct."
        },
        {
          "text": "We need some equipment.",
          "reason": "Equipment is uncountable in this meaning."
        }
      ],
      "practice": [
        {
          "type": "complete",
          "prompt": "I have three ___ (robot).",
          "promptEs": "Tengo tres ___ (robot).",
          "answer": "robots"
        },
        {
          "type": "write",
          "prompt": "Write a sentence with two sensors.",
          "promptEs": "Escribe una oración con two sensors."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "plurals",
          "count-nouns",
          "numbers"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "tested",
      "matcher": {
        "pattern": "\\b(two|three|four|five|many|several)\\s+(student|teacher|robot|project|sensor)\\b",
        "flags": "gi",
        "replacement": "$1 $2s"
      }
    },
    {
      "id": "THERE-BE-COUNT-001",
      "implementation": "there-be-singular-count",
      "level": "A1",
      "category": "there-is-are",
      "title": "Use there is with one singular count noun",
      "titleEs": "Usa there is con un sustantivo contable singular",
      "explanation": "Use there is before a/an + singular count noun. Use there are with plural nouns.",
      "explanationEs": "Usa there is antes de a/an + un sustantivo contable singular. Usa there are con sustantivos plurales.",
      "examples": [
        "There is a robot in the lab.",
        "There are two robots in the lab."
      ],
      "examplesBilingual": [
        {
          "en": "There is a robot in the lab.",
          "es": "Hay un robot en el laboratorio."
        },
        {
          "en": "There are two robots in the lab.",
          "es": "Hay dos robots en el laboratorio."
        }
      ],
      "incorrect": [
        "There are a robot in the lab."
      ],
      "exceptions": [
        "There are is correct with plural noun phrases.",
        "There is also introduces uncountable nouns: There is some equipment."
      ],
      "negativeCases": [
        {
          "text": "There are two robots.",
          "reason": "Plural agreement is correct."
        },
        {
          "text": "There is some equipment.",
          "reason": "Equipment is uncountable."
        }
      ],
      "practice": [
        {
          "type": "choose",
          "prompt": "___ a sensor on the table.",
          "promptEs": "___ un sensor sobre la mesa.",
          "answer": "There is"
        },
        {
          "type": "write",
          "prompt": "Describe one object using There is.",
          "promptEs": "Describe un objeto usando There is."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "there-is-are",
          "singular",
          "places"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "tested",
      "matcher": {
        "pattern": "\\bthere\\s+are\\s+(a|an)\\s+(robot|sensor|student|teacher|project)\\b",
        "flags": "gi",
        "replacement": "there is $1 $2"
      }
    },
    {
      "id": "DOES-BASE-001",
      "implementation": "does-question-base-verb",
      "level": "A2",
      "category": "question-forms",
      "title": "Use the base verb after does in questions",
      "titleEs": "Usa el verbo base después de does en preguntas",
      "explanation": "In a present-simple question with does, the main verb stays in its base form.",
      "explanationEs": "En una pregunta en presente simple con does, el verbo principal queda en forma base.",
      "examples": [
        "Does she teach robotics?",
        "Does the robot use a sensor?"
      ],
      "examplesBilingual": [
        {
          "en": "Does she teach robotics?",
          "es": "¿Ella enseña robótica?"
        },
        {
          "en": "Does the robot use a sensor?",
          "es": "¿El robot usa un sensor?"
        }
      ],
      "incorrect": [
        "Does she teaches robotics?"
      ],
      "exceptions": [
        "Statements correctly use third-person -s: She works here.",
        "Questions with be do not use does: Is she ready."
      ],
      "negativeCases": [
        {
          "text": "She works at a school.",
          "reason": "A statement correctly uses works."
        },
        {
          "text": "Does she work here?",
          "reason": "The question is already correct."
        }
      ],
      "practice": [
        {
          "type": "complete",
          "prompt": "Does he ___ (work) here?",
          "promptEs": "¿Él ___ aquí?",
          "answer": "work"
        },
        {
          "type": "write",
          "prompt": "Ask a present-simple question with does.",
          "promptEs": "Haz una pregunta en presente simple con does."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "present-simple",
          "does",
          "questions"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "tested",
      "matcher": {
        "pattern": "\\b(does)\\s+(he|she|it|the robot|the student)\\s+(works|teaches|builds|uses|likes|goes|studies|watches|makes|plays|reads|writes)\\b",
        "flags": "gi",
        "replacement": "$1 $2 $3",
        "transform": {
          "type": "thirdPersonToBase",
          "capture": 3
        }
      }
    },
    {
      "id": "MODAL-BASE-001",
      "implementation": "modal-base-verb",
      "level": "A2",
      "category": "modals",
      "title": "Use the base verb after a modal",
      "titleEs": "Usa el verbo base después de un modal",
      "explanation": "After can, could, should, must and will, use the base form of the main verb.",
      "explanationEs": "Después de can, could, should, must y will, usa la forma base del verbo principal.",
      "examples": [
        "She can build a robot.",
        "We should check the code."
      ],
      "examplesBilingual": [
        {
          "en": "She can build a robot.",
          "es": "Ella puede construir un robot."
        },
        {
          "en": "We should check the code.",
          "es": "Deberíamos revisar el código."
        }
      ],
      "incorrect": [
        "She can builds a robot."
      ],
      "exceptions": [
        "The modal itself does not take -s: He can, not He cans.",
        "Have to and ought to use different patterns."
      ],
      "negativeCases": [
        {
          "text": "She can build a robot.",
          "reason": "Modal + base verb is correct."
        },
        {
          "text": "He works every day.",
          "reason": "This is not a modal construction."
        }
      ],
      "practice": [
        {
          "type": "complete",
          "prompt": "He can ___ (teach) English.",
          "promptEs": "Él puede ___ inglés.",
          "answer": "teach"
        },
        {
          "type": "write",
          "prompt": "Write a sentence with should + a base verb.",
          "promptEs": "Escribe una oración con should + verbo base."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "modals",
          "ability",
          "advice"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "tested",
      "matcher": {
        "pattern": "\\b(can|could|should|must|will)\\s+(works|teaches|builds|uses|likes|goes|studies|watches|makes|plays|reads|writes)\\b",
        "flags": "gi",
        "replacement": "$1 $2",
        "transform": {
          "type": "thirdPersonToBase",
          "capture": 2
        }
      }
    },
    {
      "id": "PAST-DID-BASE-001",
      "implementation": "did-base-verb",
      "level": "A2",
      "category": "past-simple",
      "title": "Use the base verb after did",
      "titleEs": "Usa el verbo base después de did",
      "explanation": "In past-simple questions with did, use the base form of the main verb.",
      "explanationEs": "En preguntas en pasado simple con did, usa la forma base del verbo principal.",
      "examples": [
        "Did you go to the lab?",
        "Did she build the robot?"
      ],
      "examplesBilingual": [
        {
          "en": "Did you go to the lab?",
          "es": "¿Fuiste al laboratorio?"
        },
        {
          "en": "Did she build the robot?",
          "es": "¿Ella construyó el robot?"
        }
      ],
      "incorrect": [
        "Did you went to the lab?"
      ],
      "exceptions": [
        "Affirmative past statements use past forms: She built the robot.",
        "Current matching focuses on questions, not every negative construction."
      ],
      "negativeCases": [
        {
          "text": "Did you go to the lab?",
          "reason": "Did + base verb is correct."
        },
        {
          "text": "She went to the lab yesterday.",
          "reason": "Affirmative past simple is correct."
        }
      ],
      "practice": [
        {
          "type": "complete",
          "prompt": "Did you ___ (go) to class?",
          "promptEs": "¿Fuiste a clase?",
          "answer": "go"
        },
        {
          "type": "write",
          "prompt": "Ask a question about yesterday with Did you...",
          "promptEs": "Haz una pregunta sobre ayer con Did you..."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "past-simple",
          "did",
          "questions"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "tested",
      "matcher": {
        "pattern": "\\b(did)\\s+(you|he|she|they|we)\\s+(went|saw|built|made|had|worked|studied|played)\\b",
        "flags": "gi",
        "replacement": "$1 $2 $3",
        "transform": {
          "type": "pastToBase",
          "capture": 3
        }
      }
    },
    {
      "id": "PRES-CONT-BASE-001",
      "implementation": "present-continuous-ing",
      "level": "A2",
      "category": "present-continuous",
      "title": "Use an -ing form after be in the present continuous",
      "titleEs": "Usa la forma -ing después de be en presente continuo",
      "explanation": "For an action happening now, use am/is/are + the -ing form of the main verb.",
      "explanationEs": "Para una acción que ocurre ahora, usa am/is/are + la forma -ing del verbo principal.",
      "examples": [
        "I am teaching now.",
        "They are building a robot."
      ],
      "examplesBilingual": [
        {
          "en": "I am teaching now.",
          "es": "Estoy enseñando ahora."
        },
        {
          "en": "They are building a robot.",
          "es": "Están construyendo un robot."
        }
      ],
      "incorrect": [
        "I am teach now."
      ],
      "exceptions": [
        "Be + adjective/noun is valid: I am ready; They are students.",
        "Stative verbs are not normally continuous in common meanings: I know the answer."
      ],
      "negativeCases": [
        {
          "text": "I am ready.",
          "reason": "Be + adjective is correct."
        },
        {
          "text": "I know the answer.",
          "reason": "Know is stative in this meaning."
        }
      ],
      "practice": [
        {
          "type": "complete",
          "prompt": "She is ___ (teach) now.",
          "promptEs": "Ella está ___ ahora.",
          "answer": "teaching"
        },
        {
          "type": "write",
          "prompt": "Describe what someone is doing now.",
          "promptEs": "Describe qué está haciendo alguien ahora."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "present-continuous",
          "actions",
          "now"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "tested",
      "matcher": {
        "pattern": "\\b(I am|he is|she is|it is|we are|they are|you are)\\s+(work|teach|build|study|learn|write|read|use)\\b",
        "flags": "gi",
        "replacement": "$1 $2",
        "transform": {
          "type": "toGerund",
          "capture": 2
        }
      }
    },
    {
      "id": "GRAM-B1-FIRST-CONDITIONAL-002",
      "implementation": "first-conditional",
      "level": "B1",
      "category": "conditionals",
      "title": "Use the first conditional for realistic future possibilities",
      "titleEs": "Usa el primer condicional para posibilidades futuras reales",
      "explanation": "Use if + present simple followed by will/can/may + base verb for a realistic future condition and result.",
      "explanationEs": "Usa if + presente simple seguido de will/can/may + verbo base para expresar una condición futura realista y su resultado.",
      "examples": [
        "If the sensor fails, we will replace it.",
        "If we finish early, we can test the robot."
      ],
      "examplesBilingual": [
        {
          "en": "If the sensor fails, we will replace it.",
          "es": "Si falla el sensor, lo reemplazaremos."
        },
        {
          "en": "If we finish early, we can test the robot.",
          "es": "Si terminamos temprano, podemos probar el robot."
        }
      ],
      "incorrect": [
        "If the sensor will fail, we will replace it."
      ],
      "exceptions": [
        "Will is normally not used in the if-clause of this pattern.",
        "Other conditional meanings use different structures."
      ],
      "negativeCases": [
        {
          "text": "If it rains, we will stay inside.",
          "reason": "Correct first conditional."
        }
      ],
      "practice": [
        {
          "type": "guided-production",
          "prompt": "Complete: If the sensor ___ (fail), we will stop.",
          "promptEs": "Completa: If the sensor ___, nos detendremos."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "conditionals",
          "future",
          "cause-effect"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "draft"
    },
    {
      "id": "GRAM-B1-CONNECTORS-002",
      "implementation": "contrast-connectors",
      "level": "B1",
      "category": "connectors",
      "title": "Choose connectors by meaning and clause structure",
      "titleEs": "Elige conectores según el significado y la estructura",
      "explanation": "Although introduces a contrast clause; however links ideas across sentence boundaries; because introduces a reason.",
      "explanationEs": "Although introduce una oración de contraste; however enlaza ideas entre oraciones; because introduce una razón.",
      "examples": [
        "Although the task was difficult, we finished it.",
        "The task was difficult. However, we finished it."
      ],
      "examplesBilingual": [
        {
          "en": "Although the task was difficult, we finished it.",
          "es": "Aunque la tarea fue difícil, la terminamos."
        },
        {
          "en": "The task was difficult. However, we finished it.",
          "es": "La tarea fue difícil. Sin embargo, la terminamos."
        }
      ],
      "incorrect": [
        "Although the task was difficult, but we finished it."
      ],
      "exceptions": [
        "Punctuation depends on clause structure.",
        "But is not universally wrong; it is redundant in this although...but construction."
      ],
      "negativeCases": [
        {
          "text": "Although it was late, we continued.",
          "reason": "Correct contrast clause."
        }
      ],
      "practice": [
        {
          "type": "guided-production",
          "prompt": "Join two ideas using although.",
          "promptEs": "Une dos ideas usando although."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "connectors",
          "cohesion",
          "contrast"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "draft"
    },
    {
      "id": "GRAM-B2-ARGUMENT-CLAIMS-001",
      "implementation": "argument-claims",
      "level": "B2",
      "category": "argumentation",
      "title": "Support a claim with reasons and qualified evidence",
      "titleEs": "Sustenta una afirmación con razones y evidencia matizada",
      "explanation": "A clear argument distinguishes a claim, supporting reason, evidence and limitation; avoid presenting correlation as proof of causation.",
      "explanationEs": "Un argumento claro distingue afirmación, razón, evidencia y limitación; evita presentar correlación como prueba de causalidad.",
      "examples": [
        "The results suggest that the method may improve retention, although the sample was small.",
        "One limitation is that the study included only one class."
      ],
      "examplesBilingual": [
        {
          "en": "The results suggest that the method may improve retention, although the sample was small.",
          "es": "Los resultados sugieren que el método podría mejorar la retención, aunque la muestra era pequeña."
        },
        {
          "en": "One limitation is that the study included only one class.",
          "es": "Una limitación es que el estudio incluyó una sola clase."
        }
      ],
      "incorrect": [
        "The results prove the method always works, based only on one small class."
      ],
      "exceptions": [
        "The strength of wording must match the evidence.",
        "May, might, suggest and indicate express different degrees of certainty."
      ],
      "negativeCases": [
        {
          "text": "The results may suggest an improvement.",
          "reason": "Qualified wording is appropriate when evidence is limited."
        }
      ],
      "practice": [
        {
          "type": "guided-production",
          "prompt": "Write a claim with a qualification and a supporting reason.",
          "promptEs": "Escribe una afirmación con matización y una razón de apoyo."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "argumentation",
          "evidence",
          "qualification"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "draft"
    },
    {
      "id": "GRAM-B2-COHESION-001",
      "implementation": "textual-cohesion",
      "level": "B2",
      "category": "textual-cohesion",
      "title": "Maintain cohesion with reference and lexical links",
      "titleEs": "Mantén la cohesión mediante referencias y enlaces léxicos",
      "explanation": "Use pronouns, repeated key terms, synonyms and transition signals so readers can identify what each expression refers to.",
      "explanationEs": "Usa pronombres, términos clave, sinónimos y conectores para que el lector identifique los referentes.",
      "examples": [
        "The prototype failed the first test. This result led us to redesign the sensor.",
        "The team revised the plan; consequently, the launch date changed."
      ],
      "examplesBilingual": [
        {
          "en": "The prototype failed the first test. This result led us to redesign the sensor.",
          "es": "El prototipo falló la primera prueba. Este resultado nos llevó a rediseñar el sensor."
        },
        {
          "en": "The team revised the plan; consequently, the launch date changed.",
          "es": "El equipo revisó el plan; en consecuencia, cambió la fecha de lanzamiento."
        }
      ],
      "incorrect": [
        "The prototype failed. It was changed. This did that."
      ],
      "exceptions": [
        "Repetition can be useful for clarity; avoid ambiguous synonyms.",
        "Transition signals express different logical relationships and are not interchangeable."
      ],
      "negativeCases": [
        {
          "text": "The team revised the plan; consequently, the launch date changed.",
          "reason": "The transition clearly expresses a result."
        }
      ],
      "practice": [
        {
          "type": "guided-production",
          "prompt": "Revise a paragraph to clarify references and logical links.",
          "promptEs": "Revisa un párrafo para aclarar referencias y relaciones lógicas."
        }
      ],
      "activityLinks": {
        "skills": [
          "writing",
          "speaking",
          "reading"
        ],
        "activityTypes": [
          "complete",
          "choose",
          "mini-production",
          "conversation",
          "listening"
        ],
        "tags": [
          "cohesion",
          "reference",
          "transitions"
        ]
      },
      "severity": "medium",
      "priority": "high",
      "status": "draft"
    }
