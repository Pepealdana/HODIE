  "integrationContract": {
    "alwaysAvailable": [
      "grammarRules",
      "vocabularyEntries",
      "communicativeFunctions",
      "examples",
      "exceptions",
      "collocations",
      "correctionRules"
    ],
    "activityScoped": [
      "practiceDepth",
      "timeLimit",
      "supportLevel",
      "complexity",
      "masteryThreshold"
    ],
    "neverGateByActivity": [
      "global-text-correction",
      "knowledge-search",
      "vocabulary-recognition"
    ],
    "unknownWordPolicy": "Do not mark an unfamiliar word as wrong only because it is absent from the catalog."
  }
}
