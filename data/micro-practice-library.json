    {
      "id": "MIC-SP-A2-01-07",
      "canDoId": "SP-A2-01",
      "type": "mini-production",
      "skill": "speaking",
      "context": "professional",
      "level": "A2",
      "title": "Make it yours",
      "titleEs": "Hazlo tuyo",
      "prompt": "Say or write 2–3 sentences about yourself: your job, what you work with, and one thing you enjoy.",
      "promptEs": "Di o escribe 2–3 oraciones sobre ti: tu trabajo, con qué trabajas y una cosa que disfrutas.",
      "requirements": {
        "minResponseCharacters": 40
      },
      "feedback": {
        "ready": "Good. You produced a personal response.",
        "readyEs": "Bien. Produjiste una respuesta personal.",
        "short": "Add a little more. Include your job, what you work with, and one thing you enjoy.",
        "shortEs": "Agrega un poco más. Incluye tu trabajo, con qué trabajas y una cosa que disfrutas."
      },
      "tags": [
        "speaking",
        "production",
        "professional"
      ],
      "primarySkill": "speaking",
      "resources": [
        "grammar",
        "vocabulary"
      ],
      "evaluation": {
        "responseType": "free-production",
        "minimumResponseCharacters": 40,
        "minimumCriteria": 3,
        "criteria": [
          {
            "id": "profession",
            "label": "Say what you do or your profession.",
            "patterns": [
              "\\b(i am|i'm)\\s+(a|an)\\s+[a-z]+(?:\\s+[a-z]+){0,3}\\b",
              "\\b(i teach|i work as)\\b"
            ],
            "missingMessage": "Tell me what you do. For example: \"I am a technology teacher.\"",
            "missingMessageEs": "Di a qué te dedicas. Por ejemplo: \"I am a technology teacher.\""
          },
          {
            "id": "work-context",
            "label": "Say where or with whom you work.",
            "patterns": [
              "\\b(i work at|i work in|i work with|i teach at|i teach)\\b"
            ],
            "missingMessage": "Add where or with whom you work.",
            "missingMessageEs": "Agrega dónde trabajas o con quién trabajas."
          },
          {
            "id": "personal-preference",
            "label": "Say one thing you enjoy, like or love.",
            "patterns": [
              "\\b(i enjoy|i like|i love)\\b"
            ],
            "missingMessage": "Add one thing you enjoy, like or love.",
            "missingMessageEs": "Agrega una cosa que disfrutas, te gusta o te encanta."
          }
        ],
        "errorType": "task-completion"
      },
      "reviewTargets": [
        "profession",
        "work-context",
        "personal-preference",
        "speaking"
      ],
      "reviewPriority": "high"
    },
