{
  "schemaVersion": "1.0.0",
  "policy": {
    "knowledgeScope": "global",
    "activityDifficulty": "progression-gated",
    "correctionScope": "all tested rules regardless of activity links",
    "draftRuleBehavior": "searchable, explainable, not executable"
  },
  "depthStages": [
    {
      "id": "recognition",
      "label": "Recognition",
      "labelEs": "Reconocer",
      "minimumEvidence": 0
    },
    {
      "id": "guided",
      "label": "Guided",
      "labelEs": "Uso guiado",
      "minimumEvidence": 1
    },
    {
      "id": "independent",
      "label": "Independent",
      "labelEs": "Uso independiente",
      "minimumEvidence": 2
    },
    {
      "id": "nuance",
      "label": "Nuance",
      "labelEs": "Matices y precisión",
      "minimumEvidence": 4
    },
    {
      "id": "transfer",
      "label": "Transfer",
      "labelEs": "Transferencia",
      "minimumEvidence": 6
    }
  ],
  "categories": [
    {
      "id": "grammar",
      "label": "Grammar",
      "labelEs": "Gramática",
      "primaryModes": [
        "choose",
        "complete",
        "order",
        "transform",
        "spot-error",
        "correct-or-not",
        "explain-why",
        "sentence-building"
      ],
      "skills": [
        "reading",
        "writing",
        "speaking"
      ],
      "progression": [
        {
          "level": "A1",
          "focus": "recognize forms and build short accurate sentences"
        },
        {
          "level": "A2",
          "focus": "choose forms in familiar contexts and contrast present/past"
        },
        {
          "level": "B1",
          "focus": "combine structures and explain form choices"
        },
        {
          "level": "B2",
          "focus": "control nuance, complex clauses, register and exceptions"
        }
      ],
      "feedback": [
        "correct-form",
        "brief-bilingual-rule",
        "exception-note",
        "retry-with-new-example"
      ]
    },
    {
      "id": "vocabulary",
      "label": "Vocabulary",
      "labelEs": "Vocabulario",
      "primaryModes": [
        "match-meaning",
        "active-recall",
        "word-family",
        "collocation-match",
        "context-gap",
        "semantic-sort",
        "definition-guess",
        "use-in-sentence"
      ],
      "skills": [
        "reading",
        "listening",
        "speaking",
        "writing"
      ],
      "progression": [
        {
          "level": "A1",
          "focus": "recognize and retrieve everyday words"
        },
        {
          "level": "A2",
          "focus": "use collocations and common phrases"
        },
        {
          "level": "B1",
          "focus": "choose words by context and register"
        },
        {
          "level": "B2",
          "focus": "distinguish near-synonyms, connotation and precision"
        }
      ],
      "feedback": [
        "meaning-en-es",
        "pronunciation-support",
        "collocation",
        "word-family",
        "contextual-example"
      ]
