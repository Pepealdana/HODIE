        {
          "level": "A2",
          "focus": "familiar conversations and specific details"
        },
        {
          "level": "B1",
          "focus": "normal-speed speech, connected speech and implied meaning"
        },
        {
          "level": "B2",
          "focus": "extended speech, stance, nuance and competing viewpoints"
